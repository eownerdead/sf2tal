cabal-version: 3.0
name: sf2tal
version: 0.1.0.0
build-type: Simple
license: 0BSD
license-files: LICENSE.md
copyright: Copyright (C) 2024 by EOWNERDEAD <eownerdead@disroot.org>
author: EOWNERDEAD
maintainer: eownerdead@disroot.org
homepage: https://codeberg.org/eownerdead/sf2tal

common common
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DerivingVia,
    DuplicateRecordFields,
    FunctionalDependencies,
    LambdaCase,
    MultiWayIf,
    NoFieldSelectors,
    OverloadedStrings,
    ParallelListComp,
    StrictData,
    TemplateHaskell,
    TypeFamilies,
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wmissing-deriving-strategies
    -fplugin=Effectful.Plugin
    -fplugin=StackTrace.Plugin
    -fdefer-type-errors
  build-depends:
    base ^>=4.18.2.1,
    safe-exceptions ^>=0.1.7.4,
    effectful-core ^>=2.3.1.0,
    effectful-plugin ^>=1.1.0.3,
    text ^>=2.0.2,
    containers ^>=0.6.7,
    microlens-platform ^>=0.4.3.5,
    prettyprinter ^>=1.7.1,
    haskell-stack-trace-plugin ^>=0.1.3.0,


library sf2tal-lib
  import: common
  hs-source-dirs: src
  build-depends:
    effectful-microlens ^>=0.1.0.0,
    effectful-th ^>=1.0.0.1,
    template-haskell ^>=2.20.0.0,
    megaparsec ^>=9.5.0,
    parser-combinators ^>=1.3.0,
  exposed-modules:
    SF2TAL,
    SF2TAL.Utils,
    SF2TAL.Name,
    SF2TAL.PP,
    SF2TAL.Uniq,
    SF2TAL.Log,
    SF2TAL.F,
    SF2TAL.Middle,
    SF2TAL.Middle.Opt,
    SF2TAL.Tal,
  other-modules:
    SF2TAL.F.F,
    SF2TAL.F.Infer,
    SF2TAL.F.Tc,
    SF2TAL.F.Parse,
    SF2TAL.Middle.Middle,
    SF2TAL.Middle.Tc,
    SF2TAL.Middle.FromF,
    SF2TAL.Middle.FromK,
    SF2TAL.Middle.FromC,
    SF2TAL.Tal.Tal,
    SF2TAL.Tal.FromA,
    SF2TAL.Tal.Tc,
    SF2TAL.Tal.Exec,

executable sf2tal
  import: common
  hs-source-dirs: app
  main-is: sf2tal.hs
  build-depends:
    sf2tal-lib,

test-suite sf2tal-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: sf2tal-test.hs
  build-depends:
    sf2tal-lib,
    hspec ^>=2.11.9,
